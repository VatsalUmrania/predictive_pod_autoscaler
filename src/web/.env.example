# Base URL of the NEXUS FastAPI server.
#
# The web app reads this server-side only. Every request is made from a React
# Server Component or a Server Action, so the browser never talks to the API
# directly and no rewrite proxy is involved.
#
# Default when unset: http://127.0.0.1:8080
#
# The NEXUS server binds port 8080 by default:
#   nexus server start --port 8080
NEXUS_API_BASE_URL="http://127.0.0.1:8080"

# Operator bearer token for the NEXUS API.
#
# The NEXUS operator routes (dashboard, audit, and the approve/reject
# endpoints that execute remediation) require an `Authorization: Bearer <token>`
# header. This value must match the server's NEXUS_ADMIN_TOKEN.
#
# This file is read server-side only: every request is made from a React
# Server Component or a Server Action, so the token is never shipped to the
# browser.
NEXUS_API_TOKEN="change-me"
