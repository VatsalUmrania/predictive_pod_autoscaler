# AWS AI DevOps Agent — Environment Variables
# Copy this to .env and fill in real values
# (Never commit .env to git)

# ── Auth: pick ONE of the two options below ───────────────────────────────────

# Option 1 — Amazon Bedrock API Key (Bearer token)
# Simplest for local dev / CI. Get one from:
#   AWS Console → Amazon Bedrock → API Keys → Create API Key
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-...
# BEDROCK_API_KEY is accepted as an alias if you prefer that name

# Option 2 — IAM credentials (no API key needed; use a role on Lambda/ECS)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

DEFAULT_REGION=us-east-1

# ── Recommended ───────────────────────────────────────────────────────────────

# Slack Incoming Webhook URL for alerts
# Create at: Slack → Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...


# ── Optional tuning ───────────────────────────────────────────────────────────

# Bedrock model ID (change only if you need a different variant)
# AGENT_BEDROCK_MODEL=anthropic.claude-sonnet-4-5-v1:0

# Min confidence for autonomous action (0.85 = 85%)
# Below this → Slack approval request is sent instead
# AGENT_CONFIDENCE_THRESHOLD=0.85

# Set to "true" to log actions without actually calling AWS (safe for testing)
# AGENT_DRY_RUN=false

# Seconds to wait before re-checking CloudWatch after remediation
# Keep above 60s (metrics have 1-minute resolution)
# AGENT_VERIFY_WAIT_SECONDS=120

# Max execute→verify retry cycles before escalating
# AGENT_MAX_RETRIES=2

# Lambda error rate threshold (0.05 = 5%)
# AGENT_ERROR_THRESHOLD=0.05

# Only monitor Lambda functions with this prefix (empty = all)
# AGENT_LAMBDA_PREFIX=my-app-
