# AWS AI DevOps Agent — Environment Variables
# Copy this to .env and fill in real values
# (Never commit .env to git)

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key for Claude Sonnet
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Recommended ───────────────────────────────────────────────────────────────

# Slack Incoming Webhook URL for alerts
# Create at: Slack → Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── AWS credentials (only needed for local dev; use IAM roles on Lambda) ──────

AWS_DEFAULT_REGION=us-east-1

# Only set these locally — Lambda uses IAM role automatically
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── Optional tuning ───────────────────────────────────────────────────────────

# Claude model — claude-sonnet-4-5 is the latest (don't change unless needed)
# AGENT_CLAUDE_MODEL=claude-sonnet-4-5

# Min confidence for autonomous action (0.85 = 85%)
# Below this → Slack approval request is sent instead
# AGENT_CONFIDENCE_THRESHOLD=0.85

# Set to "true" to log actions without actually calling AWS (safe for testing)
# AGENT_DRY_RUN=false

# Seconds to wait before re-checking CloudWatch after remediation
# Keep above 60s (metrics have 1-minute resolution)
# AGENT_VERIFY_WAIT_SECONDS=120

# Max execute→verify retry cycles before escalating
# AGENT_MAX_RETRIES=2

# Lambda error rate threshold (0.05 = 5%)
# AGENT_ERROR_THRESHOLD=0.05

# Only monitor Lambda functions with this prefix (empty = all)
# AGENT_LAMBDA_PREFIX=my-app-
